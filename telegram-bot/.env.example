# Get from https://my.telegram.org/apps
API_ID=1234567
API_HASH=your_api_hash_here

# Get from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Optional: your Telegram user id (for /start restriction). Empty = allow everyone
OWNER_ID=

# Optional: user string session — enables 2 GB uploads (bots are capped at 2000 MB by default,
# but user accounts can send up to 2 GB per file, or 4 GB with Premium).
# Generate once with: python -m pyrogram   OR use https://replit.com/@SpEcHiDe/PyrogramStringSession
USER_SESSION=

# Optional: local Bot API server URL for large files (>50 MB via getFile / large uploads).
# Example: http://127.0.0.1:8081
BOT_API_SERVER=

# Working directory for temporary downloads
WORK_DIR=./downloads
